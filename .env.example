# Server Configuration
APP_NAME=Mosamiyan Weather Platform
APP_ENV=development
PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mosamiyan
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mosamiyan

# Cache Configuration (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Default Location (Fallback: New Delhi, India)
DEFAULT_LAT=28.6139
DEFAULT_LON=77.2090
DEFAULT_CITY=New Delhi
DEFAULT_COUNTRY=IN

# Weather Upstream Provider API Keys (Optional Fallbacks)
OPENWEATHERMAP_API_KEY=
WEATHERAPI_KEY=
CARTO_BASEMAPS_API_KEY=

# Cache TTLs (in seconds)
CACHE_TTL_CURRENT=300
CACHE_TTL_HOURLY=1800
CACHE_TTL_DAILY=3600
CACHE_TTL_GEO=86400
